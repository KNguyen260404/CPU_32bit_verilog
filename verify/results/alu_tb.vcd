$scope module dut $end
$var wire 4 7 alu_control [3:0] $end
$var wire 32 8 operand1 [31:0] $end
$var wire 32 9 operand2 [31:0] $end
$var wire 32 : signed_op1 [31:0] $end
$var wire 32 ; signed_op2 [31:0] $end
$var wire 1 ! zero_flag $end
$var wire 5 < shift_amount [4:0] $end
$var reg 32 = alu_result [31:0] $end
$upscope $end
$scope task display_test_summary $end
$var real 1 > pass_rate $end
$upscope $end
